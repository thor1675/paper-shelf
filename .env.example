POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Slack 連携（slackbot/manifest.yml でアプリを作って取得する）
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# slackbot と backend の合言葉。python3 -c "import secrets;print(secrets.token_urlsafe(32))" で作った値を入れる
BOT_TOKEN=
# 新着を知らせるチャンネルの ID（チャンネル名を右クリック →「リンクをコピー」の末尾の C から始まる文字列）
SLACK_NOTIFY_CHANNEL=
NOTIFY_HOUR=9

# OpenAlex（引用関係）の連絡先。書くと混んでいるときも応答が速い（任意）
OPENALEX_MAILTO=

# GitHub でのログイン（OAuth2）。GitHub の Settings → Developer settings → OAuth Apps で作る（任意）
# Redirect URI（Authorization callback URL）は http://localhost:8000/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
